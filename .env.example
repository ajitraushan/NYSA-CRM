NODE_ENV=development
PORT=3000

PGHOST=localhost
PGPORT=5432
PGDATABASE=nysacrm
PGUSER=nysacrmapp
PGPASSWORD=replace_with_database_password
PGPOOL_MAX=3
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=15000
PG_STATEMENT_TIMEOUT_MS=12000
PG_IDLE_TRANSACTION_TIMEOUT_MS=15000
PG_READINESS_TIMEOUT_MS=2000
PG_CONNECTION_MAX_LIFETIME_SECONDS=300
PG_CONNECTION_MAX_USES=1000

TRUST_PROXY=0
BOOTSTRAP_KEY=replace_with_random_value_for_initial_setup_only

# Create a dedicated active internal service actor and keep both values server-side only.
WEBSITE_INTAKE_ACTOR_ID=replace_with_service_actor_uuid
WEBSITE_INTAKE_SECRET=replace_with_at_least_32_random_characters

MAX_JSON_BODY_BYTES=33554432
MAX_PROPERTY_VIDEO_BYTES=20971520
PRIVATE_STORAGE_DIR=storage/private
MAX_MEDIA_BYTES=8388608
MAX_DOCUMENT_BYTES=10485760

# Optional governed AI assistance. Keep the real key only in the server/cPanel environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_BASE_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARS=12000
APOLLO_API_KEY=
APOLLO_PEOPLE_MATCH_URL=https://api.apollo.io/api/v1/people/match
APOLLO_TIMEOUT_MS=5000

# Optional Google Calendar / Meet integration. Keep all real values server-side only.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://crm-test.nysarealty.com/api/integrations/google-calendar/callback
INTEGRATION_ENCRYPTION_KEY=replace_with_at_least_32_random_characters

# Release 3B CRM Test UAT harness. Keep credentials in the process environment only.
# Mutation additionally requires the exact confirmation value documented in
# docs/RELEASE_3B_CRM_TEST_AUTOMATED_UAT.md and explicitly selected UAT record UUIDs.
NYSA_R3B_UAT_BASE_URL=https://crm-test.nysarealty.com
PROPERTY_FINDER_MEDIA_DELIVERY_SECRET=

# Property Finder Enterprise API sandbox. CRM-Test only; disabled by default.
# Store real credentials only in the CRM-Test server environment, never in this file.
NYSA_DEPLOYMENT_ENV=
PROPERTY_FINDER_ENVIRONMENT=sandbox
PROPERTY_FINDER_API_BASE_URL=https://sandbox.atlas.propertyfinder.com
PROPERTY_FINDER_SANDBOX_API_KEY=
PROPERTY_FINDER_SANDBOX_API_SECRET=
PROPERTY_FINDER_SANDBOX_EXPIRES_AT=
PROPERTY_FINDER_API_SCOPES=users:read,listings:read,credits:read,compliances:read,listing_verification:full_access,locations:read,projects:read,webhooks:full_access
PROPERTY_FINDER_TIMEOUT_MS=15000
PROPERTY_FINDER_REQUESTS_PER_MINUTE=60
PROPERTY_FINDER_SANDBOX_ENABLED=0
PROPERTY_FINDER_ALLOW_READS=0
# Separate least-privilege PF sandbox credential for PF -> CORE listing import and future Lead reads.
PROPERTY_FINDER_LISTING_IMPORT_API_KEY=
PROPERTY_FINDER_LISTING_IMPORT_API_SECRET=
PROPERTY_FINDER_LISTING_IMPORT_EXPIRES_AT=
PROPERTY_FINDER_LISTING_IMPORT_API_SCOPES=users:read,listings:read,leads:read,credits:read
PROPERTY_FINDER_LISTING_IMPORT_ALLOW_READS=0
# Separate server-side signing secret for short-lived PF listing-import review tokens (minimum 32 characters).
PROPERTY_FINDER_IMPORT_REVIEW_SECRET=

# One explicitly approved Property Finder Production draft test. CRM-Test operator process only.
# Keep all values disabled by default. Never copy sandbox credentials or real secret values into this file.
# This isolated, unmounted runner has no publish, update, unpublish or delete operation.
# Reads and the one draft POST require separate five-minute, payload-hash-bound operator approvals.
PROPERTY_FINDER_PRODUCTION_ENVIRONMENT=production
PROPERTY_FINDER_PRODUCTION_API_BASE_URL=https://atlas.propertyfinder.com
PROPERTY_FINDER_PRODUCTION_API_KEY=
PROPERTY_FINDER_PRODUCTION_API_SECRET=
PROPERTY_FINDER_PRODUCTION_DRAFT_GUARD_SECRET=
PROPERTY_FINDER_PRODUCTION_API_SCOPES=users:read,locations:read,compliances:read,listings:read,listings:full_access,credits:read
PROPERTY_FINDER_PRODUCTION_ALLOW_READS=0
PROPERTY_FINDER_PRODUCTION_ALLOW_DRAFT_CREATE=0
PROPERTY_FINDER_PRODUCTION_ALLOW_PUBLISH=0

# Release 3D Microsoft 365 Email and Calendly. Provider access remains disabled by default.
# Keep real authorization, signing and encryption values only in the eventual server environment.
INTEGRATION_SERVICE_ACTOR_ID=
MICROSOFT365_EMAIL_ENABLED=0
MICROSOFT365_TENANT_ID=
MICROSOFT365_CLIENT_ID=
MICROSOFT365_CLIENT_SECRET=
MICROSOFT365_REDIRECT_URI=
MICROSOFT365_WEBHOOK_CLIENT_STATE_SECRET=
CALENDLY_ENABLED=0
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=
