{
  "name": "nysa-crm",
  "version": "2.1.0-dev.251",
  "description": "NYSA CORE consolidated CRM Test candidate - Releases 3 to 6",
  "type": "module",
  "main": "app.cjs",
  "scripts": {
    "start": "node app.cjs",
    "test": "node --test --test-isolation=none \"test/**/*.test.js\"",
    "test:release": "node tools/run-release-tests.mjs",
    "release:package": "node tools/build-release-from-origin.mjs",
    "release:verify-package": "node tools/verify-release-provenance.mjs",
    "test:integration:reassignment": "node --test --test-isolation=none test/dev154-coordinated-reassignment.integration.test.js",
    "test:integration:inventory-eligibility": "node --test --test-isolation=none test/dev156-inventory-eligibility-real-db.integration.test.js",
    "test:fixture:full": "node --env-file=.env --test --test-isolation=process --test-concurrency=1 \"test/**/*.test.js\"",
    "db:fixture:migrate": "node --env-file=.env tools/local-postgres-fixture/migrate.mjs",
    "db:fixture:rebuild": "node --env-file=.env tools/local-postgres-fixture/rebuild.mjs",
    "uat:release3b:crm-test": "node scripts/release3b-crm-test-uat.js",
    "uat:release3b:crm-test:mutate": "node scripts/release3b-crm-test-uat.js --mutate",
    "uat:dev158:data:plan": "node scripts/dev158-manual-uat-provisioner.mjs --plan",
    "uat:dev158:data:preflight": "node scripts/dev158-manual-uat-provisioner.mjs --preflight",
    "uat:property-finder:listing-import:pre": "node scripts/property-finder-listing-import-pre-uat.js",
    "uat:property-finder:outward:pre": "node scripts/property-finder-outward-pre-uat.js",
    "test:dashboard:seed": "node scripts/seed-dashboard-fixtures.js",
    "test:dashboard:roles": "node --test --test-isolation=none test/dashboard-domain.test.js test/dashboard-requirements.test.js",
    "test:ui001:components": "node tools/ui001-browser-check.mjs",
    "test:ui001:screens": "node tools/ui001-screen-review.mjs",
    "test:ui001:tasks": "node tools/ui001-task-source-check.mjs"
  },
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.5",
    "@sparticuz/chromium": "153.0.0",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "pg": "8.22.0",
    "puppeteer-core": "25.16.0",
    "read-excel-file": "^9.3.2"
  },
  "devDependencies": {
    "axe-core": "4.14.0"
  }
}
